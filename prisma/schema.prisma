// prisma/schema.prisma
// =======================
// GENERATOR & DATASOURCE
// =======================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  //url      = env("DATABASE_URL")
}

// ============
// ENUMS
// ============

enum Role {
  CLIENT
  BARBER
  ADMIN
}

enum AppointmentStatus {
  PENDING
  DONE
  CANCELED
}

enum BarberDailyAvailabilityType {
  DAY_OFF
  CUSTOM
}

enum ExpenseCategory {
  RENT
  UTILITIES
  TAXES
  SUPPLIES
  OTHER
}

enum ClientPlanStatus {
  ACTIVE
  EXPIRED
  CANCELED
}

// ⭐ STATUS DO PEDIDO
enum OrderStatus {
  // Pedido criado, aguardando alguma ação (ex: iniciado pelo admin/barbeiro)
  PENDING

  // Pedido feito pelo cliente fora da barbearia, aguardando ele chegar para concluir
  PENDING_CHECKIN

  // ✅ Reserva expirada (prazo acabou e voltou pro estoque)
  EXPIRED

  // Venda efetivamente concluída (estoque abatido, entra no financeiro)
  COMPLETED

  // Pedido cancelado (não mexe em estoque, não entra no financeiro)
  CANCELED
}

// ✅ NOVO: níveis de cliente (gamificação)
enum CustomerLevel {
  BRONZE
  PRATA
  OURO
  DIAMANTE
}

// ✅ NOVO: tipos de regra especial de nível
enum CustomerLevelRuleType {
  HAS_ACTIVE_PLAN
}

// ============
// MODELS
// ============

model User {
  id String @id @default(cuid())

  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  passwordHash  String?

  // 🎂 Data de aniversário do cliente (opcional)
  birthday DateTime?

  role Role @default(CLIENT)

  // 🔹 Indica se esse usuário é o DONO do estabelecimento
  isOwner Boolean @default(false)

  isActive Boolean @default(true)

  // ✅ agendamentos como CLIENTE
  appointmentsAsClient Appointment[] @relation("ClientAppointments")

  // ✅ auditoria: agendamentos CONCLUÍDOS por este usuário (ADMIN/BARBER logado via User)
  appointmentsConcluded Appointment[] @relation("AppointmentConcludedByUser")

  // ✅ auditoria: agendamentos CANCELADOS por este usuário (ADMIN/BARBER logado via User)
  appointmentsCancelled Appointment[] @relation("AppointmentCancelledByUser")

  clientPlans ClientPlan[]

  barber Barber?

  accounts Account[]
  sessions Session[]

  // ⭐ PEDIDOS DO CLIENTE
  orders Order[]

  // ⭐ AVALIAÇÕES FEITAS PELO CLIENTE
  reviews AppointmentReview[]

  // 🔹 Permissões de acesso ao painel admin (quando role = ADMIN)
  adminAccess AdminAccess?

  // ✅ NOVO: estado de nível por unidade (nível vigente/earned com defasagem M -> M+1)
  customerLevelStates  CustomerLevelState[]
  customerLevelPeriods CustomerLevelPeriod[]

  // ✅ FIX: relacionamento correto (antes estava MobileAnalyticsEvent[])
  analyticsEvents AnalyticsEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 🚫 REMOVIDO: appointments Appointment[]
  // Esse campo estava "solto" e quebrava o Prisma (sem relação inversa no Appointment).
}

// =======================
// NEXTAUTH
// =======================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =======================
// 🏢 UNIDADES (FILIAIS)
// =======================

model Unit {
  id String @id @default(cuid())

  name     String
  phone    String?
  address  String?
  isActive Boolean @default(true)

  // 🔹 Horários da unidade (igual padrão do barbeiro)
  weeklyAvailabilities UnitWeeklyAvailability[]
  dailyAvailabilities  UnitDailyAvailability[]

  // 🔹 Profissionais vinculados (N:N)
  barbers BarberUnit[]

  // 🔹 Entidades “particionadas” por unidade
  appointments Appointment[]
  products     Product[]
  orders       Order[]
  expenses     Expense[]

  // ✅ vendas de produtos por unidade
  productSales ProductSale[]

  // ✅ NOVO: admins vinculados via AdminAccess
  adminAccesses AdminAccess[]

  // ✅ NOVO: lançamentos de multa de cancelamento (financeiro do barbeiro)
  cancellationFees BarberCancellationFee[]

  // ✅ NOVO: gamificação / nível do cliente (config + regras + histórico por período + estado vigente)
  customerLevelConfigs CustomerLevelConfig[]
  customerLevelRules   CustomerLevelRule[]
  customerLevelStates  CustomerLevelState[]
  customerLevelPeriods CustomerLevelPeriod[]

  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  barberWeeklyAvailabilities BarberWeeklyAvailability[]
  barberDailyAvailabilities  BarberDailyAvailability[]
  services                   Service[]

  // ✅ FIX: relacionamento correto (antes estava MobileAnalyticsEvent[])
  analyticsEvents AnalyticsEvent[]

  @@map("units")
}

// ✅ NOVO: CONFIGURAÇÃO POR NÍVEL (por unidade/tenant)
model CustomerLevelConfig {
  id String @id @default(cuid())

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  level CustomerLevel

  // ✅ Contagem do MÊS (calendário) baseada em:
  // - agendamentos status = DONE
  // - pedidos status = COMPLETED
  minAppointmentsDone Int @default(0)
  minOrdersCompleted  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([unitId, level])
  @@index([unitId])
  @@map("customer_level_configs")
}

// ✅ NOVO: REGRAS ESPECIAIS (por unidade/tenant)
model CustomerLevelRule {
  id String @id @default(cuid())

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  type CustomerLevelRuleType

  // Ex: HAS_ACTIVE_PLAN => DIAMANTE
  targetLevel CustomerLevel

  // Maior = mais prioridade (para futuros tipos de regra)
  priority  Int     @default(100)
  isEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([unitId, isEnabled])
  @@map("customer_level_rules")
}

// ✅ NOVO: ESTADO DO NÍVEL VIGENTE (por unidade + cliente)
model CustomerLevelState {
  id String @id @default(cuid())

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  levelCurrent          CustomerLevel @default(BRONZE)
  levelEarnedLastPeriod CustomerLevel @default(BRONZE)
  levelEffectiveFrom    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([unitId, userId])
  @@index([userId])
  @@index([unitId])
  @@map("customer_level_states")
}

// ✅ NOVO: HISTÓRICO POR PERÍODO (por unidade + cliente + mês)
model CustomerLevelPeriod {
  id String @id @default(cuid())

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  periodKey String

  appointmentsDone Int @default(0)
  ordersCompleted  Int @default(0)

  earnedLevel CustomerLevel @default(BRONZE)

  computedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([unitId, userId, periodKey])
  @@index([unitId, periodKey])
  @@index([userId, periodKey])
  @@map("customer_level_periods")
}

// ⭐ Pivot: BARBEIRO x UNIDADE (N:N)
model BarberUnit {
  id String @id @default(cuid())

  barberId String
  barber   Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([barberId, unitId])
  @@index([unitId])
  @@index([barberId])
  @@map("barber_units")
}

// =======================
// HORÁRIO DA UNIDADE (igual ao barbeiro)
// =======================

model UnitWeeklyAvailability {
  id     String @id @default(cuid())
  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  weekday  Int
  isActive Boolean @default(true)

  intervals UnitWeeklyTimeInterval[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([unitId, weekday])
  @@map("unit_weekly_availabilities")
}

model UnitWeeklyTimeInterval {
  id                   String                 @id @default(cuid())
  weeklyAvailabilityId String
  weeklyAvailability   UnitWeeklyAvailability @relation(fields: [weeklyAvailabilityId], references: [id], onDelete: Cascade)

  startTime String
  endTime   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("unit_weekly_time_intervals")
}

model UnitDailyAvailability {
  id     String @id @default(cuid())
  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  date     DateTime
  isClosed Boolean  @default(false)

  intervals UnitDailyTimeInterval[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([unitId, date])
  @@map("unit_daily_availabilities")
}

model UnitDailyTimeInterval {
  id                  String                @id @default(cuid())
  dailyAvailabilityId String
  dailyAvailability   UnitDailyAvailability @relation(fields: [dailyAvailabilityId], references: [id], onDelete: Cascade)

  startTime String
  endTime   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("unit_daily_time_intervals")
}

// =======================
// DOMÍNIO
// =======================

model Barber {
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  phone    String?
  isActive Boolean @default(true)

  // ✅ FOTO DO PROFISSIONAL (URL pública)
  imageUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  // 🔹 vínculo do profissional em uma ou mais unidades
  units BarberUnit[]

  appointments Appointment[]

  // ✅ auditoria: agendamentos CONCLUÍDOS por este barbeiro
  appointmentsConcluded Appointment[] @relation("AppointmentConcludedByBarber")

  // ✅ auditoria: agendamentos CANCELADOS por este barbeiro
  appointmentsCancelled Appointment[] @relation("AppointmentCancelledByBarber")

  weeklyAvailabilities BarberWeeklyAvailability[]
  dailyAvailabilities  BarberDailyAvailability[]

  // ⭐ VENDAS DE PRODUTO
  productSales ProductSale[]

  // ⭐ PEDIDOS LIGADOS AO BARBEIRO (quem fez a venda / atendeu)
  orders Order[]

  // 🔹 Serviços que esse profissional executa
  services ServiceProfessional[]

  // ⭐ AVALIAÇÕES RECEBIDAS PELO PROFISSIONAL
  reviews AppointmentReview[]

  // ✅ NOVO: lançamentos de multa de cancelamento (financeiro do barbeiro)
  cancellationFees BarberCancellationFee[]

  @@map("barbers")
}

// =======================
// SERVICES / APPOINTMENTS
// =======================

model Service {
  id String @id @default(cuid())

  name                String
  price               Decimal  @db.Decimal(10, 2)
  durationMinutes     Int
  isActive            Boolean  @default(true)
  barberPercentage    Decimal  @default(50.0) @db.Decimal(5, 2)
  cancelLimitHours    Int?
  cancelFeePercentage Decimal? @db.Decimal(5, 2)

  appointments Appointment[]
  planServices PlanService[]
  orderItems   OrderItem[]

  professionals ServiceProfessional[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  unit      Unit?    @relation(fields: [unitId], references: [id])
  unitId    String?

  @@map("services")
}

// ⭐ TABELA PIVOT: SERVIÇO x BARBEIRO/PROFISSIONAL
model ServiceProfessional {
  id String @id @default(cuid())

  serviceId String
  barberId  String

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  barber  Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serviceId, barberId])
  @@index([barberId])
  @@map("service_professionals")
}

// =======================
// PLANOS
// =======================

model Plan {
  id   String @id @default(cuid())
  name String

  description       String?
  price             Decimal @db.Decimal(10, 2)
  durationDays      Int     @default(30)
  totalBookings     Int     @default(4)
  commissionPercent Int
  isActive          Boolean @default(true)

  services    PlanService[]
  clientPlans ClientPlan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plans")
}

model PlanService {
  id String @id @default(cuid())

  planId    String
  serviceId String

  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, serviceId])
  @@map("plan_services")
}

model ClientPlan {
  id       String @id @default(cuid())
  clientId String
  planId   String

  startDate    DateTime
  endDate      DateTime
  usedBookings Int              @default(0)
  status       ClientPlanStatus @default(ACTIVE)

  client User @relation(fields: [clientId], references: [id])
  plan   Plan @relation(fields: [planId], references: [id])

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([planId])
  @@map("client_plans")
}

model Appointment {
  id     String @id @default(cuid())
  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  description String
  clientName  String
  phone       String
  scheduleAt  DateTime

  status AppointmentStatus @default(PENDING)

  clientId String
  client   User   @relation("ClientAppointments", fields: [clientId], references: [id])

  barberId String?
  barber   Barber? @relation(fields: [barberId], references: [id])

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id])

  servicePriceAtTheTime     Decimal? @db.Decimal(10, 2)
  barberPercentageAtTheTime Decimal? @db.Decimal(5, 2)
  barberEarningValue        Decimal? @db.Decimal(10, 2)

  cancelFeeApplied Boolean  @default(false)
  cancelFeeValue   Decimal? @db.Decimal(10, 2)
  cancelledByRole  Role?
  concludedByRole  Role?

  // ✅ NOVO: auditoria - quem CONCLUIU (nome/ator real)
  concludedByUserId String?
  concludedByUser   User?   @relation("AppointmentConcludedByUser", fields: [concludedByUserId], references: [id], onDelete: SetNull)

  concludedByBarberId String?
  concludedByBarber   Barber? @relation("AppointmentConcludedByBarber", fields: [concludedByBarberId], references: [id], onDelete: SetNull)

  // ✅ NOVO: auditoria - quem CANCELOU (nome/ator real)
  cancelledByUserId String?
  cancelledByUser   User?   @relation("AppointmentCancelledByUser", fields: [cancelledByUserId], references: [id], onDelete: SetNull)

  cancelledByBarberId String?
  cancelledByBarber   Barber? @relation("AppointmentCancelledByBarber", fields: [cancelledByBarberId], references: [id], onDelete: SetNull)

  clientPlanId String?
  clientPlan   ClientPlan? @relation(fields: [clientPlanId], references: [id])

  // ⭐ PEDIDO VINCULADO A ESSE ATENDIMENTO (opcional)
  order Order? @relation("AppointmentOrder")

  reviewModalShown Boolean            @default(false)
  review           AppointmentReview?

  cancellationFee BarberCancellationFee?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([unitId])
  @@index([clientId])
  @@index([barberId])
  @@index([scheduleAt])
  @@index([serviceId])
  @@index([clientPlanId])
  @@index([barberId, scheduleAt])
  @@index([concludedByUserId])
  @@index([concludedByBarberId])
  @@index([cancelledByUserId])
  @@index([cancelledByBarberId])
  @@map("appointments")
}

// =======================
// ✅ NOVO: LANÇAMENTO FINANCEIRO DE MULTA (CANCELAMENTO)
// =======================

model BarberCancellationFee {
  id String @id @default(cuid())

  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  barberId String
  barber   Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  amount Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([barberId, createdAt])
  @@index([unitId, createdAt])
  @@map("barber_cancellation_fees")
}

// =======================
// ⭐ PRODUCTS + STOCK
// =======================

model Product {
  id     String @id @default(cuid())
  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  name             String
  imageUrl         String
  description      String
  price            Decimal @db.Decimal(10, 2)
  barberPercentage Int
  category         String
  isActive         Boolean @default(true)

  isFeatured Boolean @default(false)

  stockQuantity      Int @default(0)
  pickupDeadlineDays Int @default(2)

  discounts ProductDiscountByLevel[]

  birthdayBenefitEnabled Boolean        @default(false)
  birthdayPriceLevel     CustomerLevel?

  sales      ProductSale[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([unitId])
  @@index([isFeatured])
}

model ProductDiscountByLevel {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  level       CustomerLevel
  discountPct Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, level])
  @@index([level])
  @@map("product_prices_by_level")
}

model ProductSale {
  id String @id @default(cuid())

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  barberId String
  barber   Barber @relation(fields: [barberId], references: [id])

  quantity   Int
  unitPrice  Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)

  soldAt    DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([unitId])
  @@index([productId])
  @@index([barberId])
  @@index([soldAt])
}

// =======================
// ⭐ PEDIDOS (SERVIÇOS + PRODUTOS)
// =======================

model Order {
  id String @id @default(cuid())

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  clientId String?
  client   User?   @relation(fields: [clientId], references: [id])

  appointmentId String?      @unique
  appointment   Appointment? @relation("AppointmentOrder", fields: [appointmentId], references: [id])

  barberId String?
  barber   Barber? @relation(fields: [barberId], references: [id])

  status OrderStatus @default(PENDING)

  reservedUntil       DateTime?
  expiredAt           DateTime?
  inventoryRevertedAt DateTime?

  totalAmount Decimal @default(0) @db.Decimal(10, 2)

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([unitId])
  @@index([clientId])
  @@index([appointmentId])
  @@index([barberId])
  @@map("orders")
}

model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id])

  quantity   Int     @default(1)
  unitPrice  Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
  @@index([serviceId])
  @@map("order_items")
}

// =======================
// EXPENSES
// =======================

model Expense {
  id     String @id @default(cuid())
  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  description String
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(10, 2)
  dueDate     DateTime
  isRecurring Boolean         @default(false)
  isPaid      Boolean         @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([unitId])
  @@index([dueDate])
  @@map("expenses")
}

// =======================
// DISPONIBILIDADE (AGORA POR UNIDADE)
// =======================

model BarberWeeklyAvailability {
  id       String @id @default(cuid())
  barberId String
  barber   Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  weekday   Int
  isActive  Boolean                    @default(true)
  intervals BarberWeeklyTimeInterval[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([barberId, unitId, weekday])
  @@index([unitId])
  @@index([barberId, weekday])
  @@map("barber_weekly_availabilities")
}

model BarberWeeklyTimeInterval {
  id                   String                   @id @default(cuid())
  weeklyAvailabilityId String
  weeklyAvailability   BarberWeeklyAvailability @relation(fields: [weeklyAvailabilityId], references: [id], onDelete: Cascade)
  startTime            String
  endTime              String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("barber_weekly_time_intervals")
}

model BarberDailyAvailability {
  id       String @id @default(cuid())
  barberId String
  barber   Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  date      DateTime
  type      BarberDailyAvailabilityType
  intervals BarberDailyTimeInterval[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([barberId, unitId, date])
  @@index([unitId])
  @@index([barberId, date])
  @@map("barber_daily_availabilities")
}

model BarberDailyTimeInterval {
  id                  String                  @id @default(cuid())
  dailyAvailabilityId String
  dailyAvailability   BarberDailyAvailability @relation(fields: [dailyAvailabilityId], references: [id], onDelete: Cascade)
  startTime           String
  endTime             String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("barber_daily_time_intervals")
}

// =======================
// ⭐ AVALIAÇÕES DE ATENDIMENTO
// =======================

model AppointmentReview {
  id String @id @default(cuid())

  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])

  clientId String
  client   User   @relation(fields: [clientId], references: [id])

  barberId String
  barber   Barber @relation(fields: [barberId], references: [id])

  rating  Int
  comment String?

  isAnonymousForProfessional Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags AppointmentReviewTag[]

  @@index([clientId])
  @@index([barberId])
  @@map("appointment_reviews")
}

model ReviewTag {
  id         String  @id @default(cuid())
  label      String
  isActive   Boolean @default(true)
  isNegative Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews AppointmentReviewTag[]

  @@unique([label])
  @@map("review_tags")
}

model AppointmentReviewTag {
  id String @id @default(cuid())

  reviewId String
  review   AppointmentReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  tagId String
  tag   ReviewTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([reviewId, tagId])
  @@index([tagId])
  @@map("appointment_review_tags")
}

// =======================
// ⭐ PERMISSÕES DE ADMIN
// =======================

model AdminAccess {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  canAccessDashboard     Boolean @default(false)
  canAccessCheckout      Boolean @default(false)
  canAccessAppointments  Boolean @default(false)
  canAccessProfessionals Boolean @default(false)
  canAccessServices      Boolean @default(false)
  canAccessReviews       Boolean @default(false)
  canAccessProducts      Boolean @default(false)
  canAccessClients       Boolean @default(false)

  canAccessClientLevels Boolean @default(false)
  canAccessFinance      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([unitId])
}

// =======================
// 📈 ANALYTICS (mobile events)
// =======================

model AnalyticsEvent {
  id String @id @default(cuid())

  // Quem gerou
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Por unidade (tenant)
  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  // Evento
  name String
  ts   DateTime @default(now()) // timestamp do evento (do client, quando válido)

  // Contexto útil pra heatmap/atribuição
  source           String?
  pushId           String?
  pushType         String?
  secondsSincePush Int?

  // Dados extras (livres)
  payload Json?
  context Json?

  // Debug/forense
  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([unitId, createdAt])
  @@index([userId, createdAt])
  @@index([name, createdAt])
  @@map("analytics_events")
}
