// prisma/schema.prisma
// =======================
// GENERATOR & DATASOURCE
// =======================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============
// ENUMS
// ============

enum Role {
  CLIENT
  BARBER
  ADMIN
}

enum CompanySegment {
  BARBERSHOP
  AESTHETIC
}

enum CompanyMemberRole {
  OWNER
  ADMIN
  STAFF
  CLIENT
}

enum AppointmentStatus {
  PENDING
  DONE
  CANCELED
}

enum BarberDailyAvailabilityType {
  DAY_OFF
  CUSTOM
}

enum ExpenseCategory {
  RENT
  UTILITIES
  TAXES
  SUPPLIES
  OTHER
}

enum ClientPlanStatus {
  ACTIVE
  EXPIRED
  CANCELED
}

// ⭐ STATUS DO PEDIDO
enum OrderStatus {
  PENDING
  PENDING_CHECKIN
  EXPIRED
  COMPLETED
  CANCELED
}

// ✅ níveis de cliente (gamificação)
enum CustomerLevel {
  BRONZE
  PRATA
  OURO
  DIAMANTE
}

// ✅ tipos de regra especial de nível
enum CustomerLevelRuleType {
  HAS_ACTIVE_PLAN
}

// ============
// MODELS
// ============

model Company {
  id String @id @default(cuid())

  name     String
  segment  CompanySegment @default(BARBERSHOP)
  isActive Boolean        @default(true)

  // relations
  members CompanyMember[]
  units   Unit[]

  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  customerLevelConfigs       CustomerLevelConfig[]
  customerLevelRules         CustomerLevelRule[]
  customerLevelStates        CustomerLevelState[]
  customerLevelPeriods       CustomerLevelPeriod[]
  barberUnits                BarberUnit[]
  unitWeeklyAvailabilities   UnitWeeklyAvailability[]
  unitDailyAvailabilities    UnitDailyAvailability[]
  barbers                    Barber[]
  services                   Service[]
  serviceProfessionals       ServiceProfessional[]
  plans                      Plan[]
  planServices               PlanService[]
  clientPlans                ClientPlan[]
  appointments               Appointment[]
  barberCancellationFees     BarberCancellationFee[]
  products                   Product[]
  productDiscountByLevels    ProductDiscountByLevel[]
  productSales               ProductSale[]
  orders                     Order[]
  orderItems                 OrderItem[]
  expenses                   Expense[]
  barberWeeklyAvailabilities BarberWeeklyAvailability[]
  barberDailyAvailabilities  BarberDailyAvailability[]
  appointmentReviews         AppointmentReview[]
  reviewTags                 ReviewTag[]
  adminAccesses              AdminAccess[]
  analyticsEvents            AnalyticsEvent[]

  @@index([segment])
  @@map("companies")
}

model CompanyMember {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role     CompanyMemberRole @default(CLIENT)
  isActive Boolean           @default(true)

  // opcional: última unidade usada nessa empresa (melhora UX)
  lastUnitId String?
  lastUnit   Unit?   @relation(fields: [lastUnitId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, userId])
  @@index([userId])
  @@index([companyId, role])
  @@map("company_members")
}

model User {
  id String @id @default(cuid())

  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  passwordHash  String?

  birthday DateTime?

  // ⚠️ Mantido por compatibilidade com seu código atual.
  // No multi-tenant, o "papel real" por empresa vai ficar em CompanyMember.role.
  role Role @default(CLIENT)

  // ⚠️ Mantido por compatibilidade.
  // No multi-tenant, "dono" por empresa vai ficar em CompanyMember.role = OWNER.
  isOwner Boolean @default(false)

  isActive Boolean @default(true)

  // memberships
  companyMemberships CompanyMember[]

  // agendamentos como CLIENTE
  appointmentsAsClient Appointment[] @relation("ClientAppointments")

  // auditoria
  appointmentsConcluded Appointment[] @relation("AppointmentConcludedByUser")
  appointmentsCancelled Appointment[] @relation("AppointmentCancelledByUser")

  clientPlans ClientPlan[]

  barber Barber?

  accounts Account[]
  sessions Session[]

  orders  Order[]
  reviews AppointmentReview[]

  adminAccesses AdminAccess[]

  customerLevelStates  CustomerLevelState[]
  customerLevelPeriods CustomerLevelPeriod[]

  analyticsEvents AnalyticsEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =======================
// NEXTAUTH (GLOBAL)
// =======================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =======================
// 🏢 UNIDADES (FILIAIS)
// =======================

model Unit {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name     String
  phone    String?
  address  String?
  isActive Boolean @default(true)

  weeklyAvailabilities UnitWeeklyAvailability[]
  dailyAvailabilities  UnitDailyAvailability[]

  barbers BarberUnit[]

  appointments Appointment[]
  products     Product[]
  orders       Order[]
  expenses     Expense[]

  productSales ProductSale[]

  adminAccesses AdminAccess[]

  cancellationFees BarberCancellationFee[]

  customerLevelConfigs CustomerLevelConfig[]
  customerLevelRules   CustomerLevelRule[]
  customerLevelStates  CustomerLevelState[]
  customerLevelPeriods CustomerLevelPeriod[]

  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  barberWeeklyAvailabilities BarberWeeklyAvailability[]
  barberDailyAvailabilities  BarberDailyAvailability[]
  services                   Service[]

  analyticsEvents AnalyticsEvent[]

  // reverse relation from CompanyMember.lastUnit
  lastUsedByMembers CompanyMember[]

  @@index([companyId])
  @@map("units")
}

// ✅ CONFIGURAÇÃO POR NÍVEL (por unidade)
model CustomerLevelConfig {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  level CustomerLevel

  minAppointmentsDone Int @default(0)
  minOrdersCompleted  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([unitId, level])
  @@index([companyId])
  @@index([unitId])
  @@map("customer_level_configs")
}

model CustomerLevelRule {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  type        CustomerLevelRuleType
  targetLevel CustomerLevel

  priority  Int     @default(100)
  isEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, isEnabled])
  @@index([unitId, isEnabled])
  @@map("customer_level_rules")
}

model CustomerLevelState {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  levelCurrent          CustomerLevel @default(BRONZE)
  levelEarnedLastPeriod CustomerLevel @default(BRONZE)
  levelEffectiveFrom    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([unitId, userId])
  @@index([companyId])
  @@index([userId])
  @@index([unitId])
  @@map("customer_level_states")
}

model CustomerLevelPeriod {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  periodKey String

  appointmentsDone Int @default(0)
  ordersCompleted  Int @default(0)

  earnedLevel CustomerLevel @default(BRONZE)

  computedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([unitId, userId, periodKey])
  @@index([companyId, periodKey])
  @@index([unitId, periodKey])
  @@index([userId, periodKey])
  @@map("customer_level_periods")
}

// ⭐ Pivot: BARBEIRO x UNIDADE (N:N)
model BarberUnit {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  barberId String
  barber   Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([barberId, unitId])
  @@index([companyId])
  @@index([unitId])
  @@index([barberId])
  @@map("barber_units")
}

// =======================
// HORÁRIO DA UNIDADE
// =======================

model UnitWeeklyAvailability {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  weekday  Int
  isActive Boolean @default(true)

  intervals UnitWeeklyTimeInterval[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([unitId, weekday])
  @@index([companyId])
  @@map("unit_weekly_availabilities")
}

model UnitWeeklyTimeInterval {
  id                   String                 @id @default(cuid())
  weeklyAvailabilityId String
  weeklyAvailability   UnitWeeklyAvailability @relation(fields: [weeklyAvailabilityId], references: [id], onDelete: Cascade)

  startTime String
  endTime   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("unit_weekly_time_intervals")
}

model UnitDailyAvailability {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  date     DateTime
  isClosed Boolean  @default(false)

  intervals UnitDailyTimeInterval[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([unitId, date])
  @@index([companyId])
  @@map("unit_daily_availabilities")
}

model UnitDailyTimeInterval {
  id                  String                @id @default(cuid())
  dailyAvailabilityId String
  dailyAvailability   UnitDailyAvailability @relation(fields: [dailyAvailabilityId], references: [id], onDelete: Cascade)

  startTime String
  endTime   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("unit_daily_time_intervals")
}

// =======================
// DOMÍNIO
// =======================

model Barber {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name     String
  email    String
  phone    String?
  isActive Boolean @default(true)

  imageUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  units BarberUnit[]

  appointments Appointment[]

  appointmentsConcluded Appointment[] @relation("AppointmentConcludedByBarber")
  appointmentsCancelled Appointment[] @relation("AppointmentCancelledByBarber")

  weeklyAvailabilities BarberWeeklyAvailability[]
  dailyAvailabilities  BarberDailyAvailability[]

  productSales ProductSale[]
  orders       Order[]

  services ServiceProfessional[]

  reviews AppointmentReview[]

  cancellationFees BarberCancellationFee[]

  @@unique([companyId, email])
  @@index([companyId])
  @@map("barbers")
}

// =======================
// SERVICES / APPOINTMENTS
// =======================

model Service {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id])

  name                String
  price               Decimal  @db.Decimal(10, 2)
  durationMinutes     Int
  isActive            Boolean  @default(true)
  barberPercentage    Decimal  @default(50.0) @db.Decimal(5, 2)
  cancelLimitHours    Int?
  cancelFeePercentage Decimal? @db.Decimal(5, 2)

  appointments Appointment[]
  planServices PlanService[]
  orderItems   OrderItem[]

  professionals ServiceProfessional[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([unitId])
  @@map("services")
}

model ServiceProfessional {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  serviceId String
  barberId  String

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  barber  Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serviceId, barberId])
  @@index([companyId])
  @@index([barberId])
  @@map("service_professionals")
}

// =======================
// PLANOS
// =======================

model Plan {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name String

  description       String?
  price             Decimal @db.Decimal(10, 2)
  durationDays      Int     @default(30)
  totalBookings     Int     @default(4)
  commissionPercent Int
  isActive          Boolean @default(true)

  services    PlanService[]
  clientPlans ClientPlan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("plans")
}

model PlanService {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  planId    String
  serviceId String

  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, serviceId])
  @@index([companyId])
  @@map("plan_services")
}

model ClientPlan {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  clientId String
  planId   String

  startDate    DateTime
  endDate      DateTime
  usedBookings Int              @default(0)
  status       ClientPlanStatus @default(ACTIVE)

  client User @relation(fields: [clientId], references: [id])
  plan   Plan @relation(fields: [planId], references: [id])

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([clientId])
  @@index([planId])
  @@map("client_plans")
}

model Appointment {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  description String
  clientName  String
  phone       String
  scheduleAt  DateTime

  status AppointmentStatus @default(PENDING)

  clientId String
  client   User   @relation("ClientAppointments", fields: [clientId], references: [id])

  barberId String?
  barber   Barber? @relation(fields: [barberId], references: [id])

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id])

  servicePriceAtTheTime     Decimal? @db.Decimal(10, 2)
  barberPercentageAtTheTime Decimal? @db.Decimal(5, 2)
  barberEarningValue        Decimal? @db.Decimal(10, 2)

  cancelFeeApplied Boolean  @default(false)
  cancelFeeValue   Decimal? @db.Decimal(10, 2)
  cancelledByRole  Role?
  concludedByRole  Role?

  concludedByUserId String?
  concludedByUser   User?   @relation("AppointmentConcludedByUser", fields: [concludedByUserId], references: [id], onDelete: SetNull)

  concludedByBarberId String?
  concludedByBarber   Barber? @relation("AppointmentConcludedByBarber", fields: [concludedByBarberId], references: [id], onDelete: SetNull)

  cancelledByUserId String?
  cancelledByUser   User?   @relation("AppointmentCancelledByUser", fields: [cancelledByUserId], references: [id], onDelete: SetNull)

  cancelledByBarberId String?
  cancelledByBarber   Barber? @relation("AppointmentCancelledByBarber", fields: [cancelledByBarberId], references: [id], onDelete: SetNull)

  clientPlanId String?
  clientPlan   ClientPlan? @relation(fields: [clientPlanId], references: [id])

  order Order? @relation("AppointmentOrder")

  reviewModalShown Boolean            @default(false)
  review           AppointmentReview?

  cancellationFee BarberCancellationFee?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([unitId])
  @@index([clientId])
  @@index([barberId])
  @@index([scheduleAt])
  @@index([serviceId])
  @@index([clientPlanId])
  @@index([barberId, scheduleAt])
  @@index([concludedByUserId])
  @@index([concludedByBarberId])
  @@index([cancelledByUserId])
  @@index([cancelledByBarberId])
  @@map("appointments")
}

// =======================
// MULTA CANCELAMENTO
// =======================

model BarberCancellationFee {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  barberId String
  barber   Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  amount Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([barberId, createdAt])
  @@index([unitId, createdAt])
  @@map("barber_cancellation_fees")
}

// =======================
// PRODUCTS + STOCK
// =======================

model Product {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  name             String
  imageUrl         String
  description      String
  price            Decimal @db.Decimal(10, 2)
  barberPercentage Int
  category         String
  isActive         Boolean @default(true)

  isFeatured Boolean @default(false)

  stockQuantity      Int @default(0)
  pickupDeadlineDays Int @default(2)

  discounts ProductDiscountByLevel[]

  birthdayBenefitEnabled Boolean        @default(false)
  birthdayPriceLevel     CustomerLevel?

  sales      ProductSale[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([companyId])
  @@index([unitId])
  @@index([isFeatured])
}

model ProductDiscountByLevel {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  level       CustomerLevel
  discountPct Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, level])
  @@index([companyId])
  @@index([level])
  @@map("product_prices_by_level")
}

model ProductSale {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  barberId String
  barber   Barber @relation(fields: [barberId], references: [id])

  quantity   Int
  unitPrice  Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)

  soldAt    DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([unitId])
  @@index([productId])
  @@index([barberId])
  @@index([soldAt])
}

// =======================
// PEDIDOS
// =======================

model Order {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  clientId String?
  client   User?   @relation(fields: [clientId], references: [id])

  // ✅ 1:1 com Appointment (um pedido por agendamento)
  appointmentId String?      @unique
  appointment   Appointment? @relation("AppointmentOrder", fields: [appointmentId], references: [id])

  barberId String?
  barber   Barber? @relation(fields: [barberId], references: [id])

  status OrderStatus @default(PENDING)

  reservedUntil       DateTime?
  expiredAt           DateTime?
  inventoryRevertedAt DateTime?

  totalAmount Decimal @default(0) @db.Decimal(10, 2)

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([unitId])
  @@index([clientId])
  @@index([appointmentId])
  @@index([barberId])
  @@map("orders")
}

model OrderItem {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id])

  quantity   Int     @default(1)
  unitPrice  Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([orderId])
  @@index([productId])
  @@index([serviceId])
  @@map("order_items")
}

// =======================
// EXPENSES
// =======================

model Expense {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  description String
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(10, 2)
  dueDate     DateTime
  isRecurring Boolean         @default(false)
  isPaid      Boolean         @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([companyId])
  @@index([unitId])
  @@index([dueDate])
  @@map("expenses")
}

// =======================
// DISPONIBILIDADE (POR UNIDADE)
// =======================

model BarberWeeklyAvailability {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  barberId String
  barber   Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  weekday   Int
  isActive  Boolean                    @default(true)
  intervals BarberWeeklyTimeInterval[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([barberId, unitId, weekday])
  @@index([companyId])
  @@index([unitId])
  @@index([barberId, weekday])
  @@map("barber_weekly_availabilities")
}

model BarberWeeklyTimeInterval {
  id                   String                   @id @default(cuid())
  weeklyAvailabilityId String
  weeklyAvailability   BarberWeeklyAvailability @relation(fields: [weeklyAvailabilityId], references: [id], onDelete: Cascade)
  startTime            String
  endTime              String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("barber_weekly_time_intervals")
}

model BarberDailyAvailability {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  barberId String
  barber   Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  date      DateTime
  type      BarberDailyAvailabilityType
  intervals BarberDailyTimeInterval[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([barberId, unitId, date])
  @@index([companyId])
  @@index([unitId])
  @@index([barberId, date])
  @@map("barber_daily_availabilities")
}

model BarberDailyTimeInterval {
  id                  String                  @id @default(cuid())
  dailyAvailabilityId String
  dailyAvailability   BarberDailyAvailability @relation(fields: [dailyAvailabilityId], references: [id], onDelete: Cascade)
  startTime           String
  endTime             String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("barber_daily_time_intervals")
}

// =======================
// AVALIAÇÕES
// =======================

model AppointmentReview {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])

  clientId String
  client   User   @relation(fields: [clientId], references: [id])

  barberId String
  barber   Barber @relation(fields: [barberId], references: [id])

  rating  Int
  comment String?

  isAnonymousForProfessional Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags AppointmentReviewTag[]

  @@index([companyId])
  @@index([clientId])
  @@index([barberId])
  @@map("appointment_reviews")
}

model ReviewTag {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  label      String
  isActive   Boolean @default(true)
  isNegative Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews AppointmentReviewTag[]

  @@unique([companyId, label])
  @@index([companyId])
  @@map("review_tags")
}

model AppointmentReviewTag {
  id String @id @default(cuid())

  reviewId String
  review   AppointmentReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  tagId String
  tag   ReviewTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([reviewId, tagId])
  @@index([tagId])
  @@map("appointment_review_tags")
}

// =======================
// PERMISSÕES DE ADMIN
// =======================

model AdminAccess {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  canAccessDashboard Boolean @default(false)

  // ✅ NOVO: Relatórios
  canAccessReports Boolean @default(false)

  canAccessCheckout      Boolean @default(false)
  canAccessAppointments  Boolean @default(false)
  canAccessProfessionals Boolean @default(false)
  canAccessServices      Boolean @default(false)
  canAccessReviews       Boolean @default(false)
  canAccessProducts      Boolean @default(false)
  canAccessClients       Boolean @default(false)

  canAccessClientLevels Boolean @default(false)
  canAccessFinance      Boolean @default(false)

  // ✅ novo: módulo Configurações
  canAccessSettings Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([unitId])
  @@index([userId])
  @@map("admin_access")
}

// =======================
// 📈 ANALYTICS (mobile events)
// =======================

model AnalyticsEvent {
  id String @id @default(cuid())

  // ✅ multi-tenant
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  // Quem gerou
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Por unidade
  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  // Evento
  name String
  ts   DateTime @default(now())

  source           String?
  pushId           String?
  pushType         String?
  secondsSincePush Int?

  payload Json?
  context Json?

  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([unitId, createdAt])
  @@index([userId, createdAt])
  @@index([name, createdAt])
  @@map("analytics_events")
}
